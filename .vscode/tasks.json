{
  "version": "2.0.0",
  "tasks": [
      {
          "label": "pre-commit",
          "type": "shell",
          "command": "uv run pre-commit run --all-files",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "pytest",
          "type": "shell",
          "command": "uv run pytest --cov --cov-report=html:coverage_report",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "mypy",
          "type": "shell",
          "command": "uv run mypy",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "ruff",
          "type": "shell",
          "command": "uv run ruff check .",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "tests",
          "dependsOn": ["pytest", "mypy", "ruff"],
          "group": {
              "kind": "test",
              "isDefault": true
          }
      },
      {
          "label": "format",
          "type": "shell",
          "command": "uv run ruff format .",
          "group": {
              "kind": "build",
              "isDefault": false
          }
      },
      {
          "label": "release: bump version",
          "detail": "Bump the version, commit it and create the annotated vX.Y.Z tag",
          "type": "shell",
          "command": "uv version --bump ${input:bump} && version=$(uv version --short) && git commit -m \"chore(release): $version\" pyproject.toml uv.lock && git tag -a \"v$version\" -m \"v$version\"",
          "problemMatcher": []
      },
      {
          "label": "release: push",
          "detail": "Push the branch with its release tag; the tag starts the Release workflow",
          "type": "shell",
          "command": "git push --follow-tags",
          "problemMatcher": []
      }
  ],
  "inputs": [
      {
          "id": "bump",
          "type": "pickString",
          "description": "Version part to bump",
          "options": ["patch", "minor", "major"],
          "default": "patch"
      }
  ]
}
