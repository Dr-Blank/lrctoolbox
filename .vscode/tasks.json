{
  "version": "2.0.0",
  "tasks": [
      {
          "label": "pre-commit",
          "type": "shell",
          "command": "uv run pre-commit run --all-files",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "pytest",
          "type": "shell",
          "command": "uv run pytest --cov --cov-report=html:coverage_report",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "mypy",
          "type": "shell",
          "command": "uv run mypy",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "ruff",
          "type": "shell",
          "command": "uv run ruff check .",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "tests",
          "dependsOn": ["pytest", "mypy", "ruff"],
          "group": {
              "kind": "test",
              "isDefault": true
          }
      },
      {
          "label": "format",
          "type": "shell",
          "command": "uv run ruff format .",
          "group": {
              "kind": "build",
              "isDefault": false
          }
      }
  ]
}
