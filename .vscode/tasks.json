{
  "version": "2.0.0",
  "tasks": [
      {
          "label": "pre-commit",
          "type": "shell",
          "command": "uv run pre-commit",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "pytest",
          "type": "shell",
          "command": "uv run pytest --cov --cov-report=html:coverage_report",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "mypy",
          "type": "shell",
          "command": "uv run mypy lrctoolbox/",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "pylint",
          "type": "shell",
          "command": "uv run pylint lrctoolbox/",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "flake8",
          "type": "shell",
          "command": "uv run flake8 lrctoolbox/",
          "group": {
              "kind": "test",
              "isDefault": false
          }
      },
      {
          "label": "tests",
          "dependsOn": ["pytest", "mypy", "pylint", "flake8"],
          "group": {
              "kind": "test",
              "isDefault": true
          }
      },
      {
          "label": "black",
          "type": "shell",
          "command": "uv run black lrctoolbox/",
          "group": {
              "kind": "build",
              "isDefault": false
          }
      }
  ]
}